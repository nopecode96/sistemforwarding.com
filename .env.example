# ==============================================================================
# SISTEMFORWARDING.COM - PRODUCTION INFRASTRUCTURE ENVIRONMENT TEMPLATE
# Copy this file to .env and configure with your production credentials
# ==============================================================================

NODE_ENV=production
APP_NAME="Sistem Forwarding B2B SaaS"
APP_DOMAIN=sistemforwarding.com
NEXT_PUBLIC_APP_DOMAIN=sistemforwarding.com
NEXT_PUBLIC_APP_URL=https://sistemforwarding.com
PORT=3000

# PostgreSQL 16 Database Configuration
POSTGRES_DB=sistemforwarding_db
POSTGRES_USER=sf_admin
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_PORT=5432

DATABASE_URL="postgresql://sf_admin:your_secure_postgres_password_here@postgres:5432/sistemforwarding_db?schema=public"
DIRECT_URL="postgresql://sf_admin:your_secure_postgres_password_here@127.0.0.1:5432/sistemforwarding_db?schema=public"

# Redis 7 In-Memory Cache & Session Store
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_URL="redis://:your_secure_redis_password_here@redis:6379"
REDIS_HOST_URL="redis://:your_secure_redis_password_here@127.0.0.1:6379"

# Authentication & JWT Secrets (Wildcard *.sistemforwarding.com)
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_here
NEXTAUTH_SECRET=your_super_secret_jwt_key_min_32_chars_here
NEXTAUTH_URL=https://sistemforwarding.com

# Google Cloud OAuth 2.0 Client Credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# BorderPay Automated Payment Gateway (Dynamic QRIS & Settlement Webhooks)
BORDERPAY_API_KEY_TEST=your_borderpay_api_key_here
BORDERPAY_VERIFICATION_TOKEN=your_borderpay_webhook_secret_token_here
BORDERPAY_WEBHOOK_URL=https://sistemforwarding.com/api/webhooks/borderpay

# Hostinger Transactional Notification Services (Email SMTP & WhatsApp Business API)
HOSTINGER_API_TOKEN=your_hostinger_api_token_here
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=notification@sistemforwarding.com
SMTP_PASS=your_smtp_password_here
