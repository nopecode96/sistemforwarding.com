datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==============================================================================
// ENUMS (Strict Domain Types for B2B Freight Forwarding Multi-Tenant Core)
// ==============================================================================

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

enum UserRole {
  SUPERADMIN     // Global platform operator across all tenants
  TENANT_ADMIN   // Company administrator with full tenant governance
  FINANCE        // Accounting & finance specialist (Invoicing, AP/AR)
  OPERATOR       // Operational specialist (managing Job Files, shipments)
  MANAGEMENT     // Read-only executive reports & KPIs
}

enum PrefixType {
  JOB_FILE
  INVOICE
  PAYMENT_VOUCHER
  QUOTATION
  BILL_OF_LADING
  AIRWAY_BILL
}

enum VendorCategory {
  CARRIER_SEA
  CARRIER_AIR
  HAULAGE_TRUCK
  CUSTOMS_BROKER
  OTHERS
}

enum PortType {
  SEA_PORT
  AIR_PORT
  INLAND_TERMINAL
}

enum ChargeCategory {
  FREIGHT        // Ocean freight, Air freight
  ORIGIN         // THC origin, BL fee, export customs, trucking pick-up
  DESTINATION    // THC destination, import customs, delivery order fee, delivery trucking
  DOCUMENTATION  // Bill of lading, AWB fee, certificate of origin
  MISCELLANEOUS  // Storage, demurrage, detention
}

enum JobFileStatus {
  DRAFT
  BOOKED
  IN_TRANSIT
  CUSTOMS_CLEARANCE
  ARRIVED
  DELIVERED
  INVOICED
  CLOSED
  CANCELLED
}

enum TransportMode {
  SEA
  AIR
  INLAND
  MULTIMODAL
}

enum ShipmentType {
  IMPORT
  EXPORT
  DOMESTIC
  CROSS_TRADE
}

enum BillingStatus {
  UNBILLED
  PARTIALLY_BILLED
  FULLY_BILLED
  PAID
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum UnitCategory {
  WEIGHT     // Satuan berat (Kg, Ton, Lbs)
  VOLUME     // Satuan volume (CBM, Liters)
  PACKAGE    // Satuan kemasan koli (Cartons, Pallets, Drums, Bags)
  CONTAINER  // Tipe & dimensi kontainer (20'DC, 40'DC, 40'HC, TEU, FEU)
  TRUCK      // Tipe & dimensi armada truk (CDE, CDD, Wingbox, Trip)
  TIME       // Satuan durasi waktu operasional (Days, Months, Hours)
  DOCUMENT   // Satuan dokumen perolehan (HBL, MBL, AWB, Shipment)
}

enum BizMode {
  SEA
  AIR
  INLAND
}

enum Bound {
  EXPORT
  IMPORT
  DOMESTIC
}

// ==============================================================================
// 1. TENANT ENTITY (Isolated Workspace & Multi-Tenant Boundary)
// ==============================================================================

model Tenant {
  id                 String             @id @default(cuid())
  subdomain          String             @unique // E.g., 'demo1' -> demo1.sistemforwarding.com
  companyName        String
  legalName          String?
  logoUrl            String?            // Custom tenant branding logo
  taxId              String?            // NPWP Perusahaan
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  subscriptionTier   String             @default("STARTER") // Driven dynamically from DB pricing models
  trialEndsAt        DateTime?
  billingCycle       String             @default("MONTHLY")
  isActive           Boolean            @default(true)
  settings           Json?              // Tenant visual branding, custom localized labels, preferences

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Tenant-scoped relational collections
  users              User[]
  prefixes           MasterPrefix[]
  financialSettings  FinancialSettings?
  taxes              MasterTax[]
  currencies         MasterCurrency[]
  vendors            MasterVendor[]
  customers          MasterCustomer[]
  chargeCodes        MasterChargeCode[]
  jobFiles           JobFile[]
  invoices           Invoice[]
  dictionaries       SystemDictionary[]

  @@map("tenants")
}

// ==============================================================================
// 2. USER ENTITY (RBAC and Tenant Membership)
// Roles: SUPERADMIN (Platform), TENANT_ADMIN, FINANCE, OPERATOR, MANAGEMENT
// ==============================================================================

model User {
  id           String    @id @default(cuid())
  email        String
  passwordHash String?
  name         String
  phone        String?
  role         UserRole  @default(OPERATOR)
  isActive     Boolean   @default(true)

  // Tenant Relationship (null for SuperAdmin portal users, non-null for tenant workspace users)
  tenantId     String?
  tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@map("users")
}

// ==============================================================================
// 3. MASTER PREFIX ENTITY (Database-Driven Auto-Numbering Engine)
// Stores numbering pattern: {PREFIX}/{YEAR}/{MONTH}/{SEQ} with atomic counter
// ==============================================================================

model MasterPrefix {
  id              String      @id @default(cuid())
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  prefixType      PrefixType  // Enum: JOB_FILE, INVOICE, PAYMENT_VOUCHER, QUOTATION, etc.
  prefixCode      String      // E.g., 'JF', 'INV', 'PV'
  zeroPadding     Int         @default(5) // E.g., 5 -> 00001
  currentSequence Int         @default(0) // Monotonically incrementing operational sequence
  delimiter       String      @default("/")
  formatPattern   String      @default("{PREFIX}/{YEAR}/{MONTH}/{SEQ}") // Tokenized structure
  resetCycle      String      @default("YEARLY") // 'NEVER', 'MONTHLY', 'YEARLY'
  lastResetAt     DateTime?
  description     String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([tenantId, prefixType])
  @@index([tenantId])
  @@map("master_prefixes")
}

// ==============================================================================
// 4. FINANCIAL SETTINGS ENTITY (Tenant Accounting & Tax Policy Configuration)
// ==============================================================================

model FinancialSettings {
  id                     String          @id @default(cuid())
  tenantId               String          @unique
  tenant                 Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  baseCurrencyId         String?
  baseCurrencyRef        MasterCurrency? @relation(fields: [baseCurrencyId], references: [id], onDelete: SetNull)
  baseCurrency           String          @default("IDR") // Base functional currency (IDR, USD, SGD)
  fiscalYearStartMonth   Int             @default(1)     // 1 = January
  lockedUntilPeriod      DateTime?       // Financial lock: records before this timestamp are read-only
  isPeriodLockActive     Boolean         @default(false)
  defaultPaymentTermDays Int             @default(30)    // Default TOP in days
  autoInvoiceOnJobDone   Boolean         @default(false)
  taxCalculationMode     String          @default("EXCLUSIVE") // EXCLUSIVE or INCLUSIVE

  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@map("financial_settings")
}

// ==============================================================================
// 5. MASTER TAX ENTITY (PPN Tarif Konfigurasi per Tenant)
// Stores rates like PPN Jasa Pengurusan Transportasi 1.1%, Standard PPN 11%/12%
// ==============================================================================

model MasterTax {
  id              String             @id @default(cuid())
  tenantId        String
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  taxCode         String             // E.g., 'PPN_JPT_1_1', 'PPN_11', 'NON_PPN'
  taxName         String             // E.g., 'PPN Jasa Pengurusan Transportasi (PMK 71) 1.1%', 'PPN Standar 11%'
  taxRatePercent  Decimal            @db.Decimal(6, 3) // E.g., 1.100 (%) or 11.000 (%)
  isDefault       Boolean            @default(false)
  isActive        Boolean            @default(true)
  description     String?

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  chargeCodes     MasterChargeCode[]
  invoices        Invoice[]

  @@unique([tenantId, taxCode])
  @@index([tenantId])
  @@map("master_taxes")
}

// ==============================================================================
// 6. MASTER CURRENCY ENTITY (Opsi Mata Uang, Simbol & Kurs Konversi Standar)
// Master data opsi mata uang (contoh: IDR, USD, SGD, EUR) untuk dropdown & rate
// ==============================================================================

model MasterCurrency {
  id                String              @id @default(cuid())
  tenantId          String?             // null = global standard currency, non-null = tenant specific rate override
  tenant            Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  code              String              // E.g., 'IDR', 'USD', 'SGD', 'EUR'
  name              String              // E.g., 'Indonesian Rupiah', 'United States Dollar'
  symbol            String              // E.g., 'Rp', '$', 'S$', '€'
  exchangeRate      Decimal             @default(1.0) @db.Decimal(18, 6) // Nilai tukar standar terhadap functional base (misal USD -> 16,000 IDR)
  isBaseCurrency    Boolean             @default(false)
  isActive          Boolean             @default(true)

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  financialSettings FinancialSettings[]
  chargeCodes       MasterChargeCode[]
  jobFiles          JobFile[]
  invoices          Invoice[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([code])
  @@map("master_currencies")
}

// ==============================================================================
// 7. MASTER UNIT ENTITY (Satuan & Dimensi Kargo / Armada Standar Logistik)
// Global shared master data tanpa tenantId: WEIGHT, VOLUME, PACKAGE, CONTAINER, TRUCK
// ==============================================================================

model MasterUnit {
  id                String             @id @default(cuid())
  unitCode          String             @unique // E.g., 'KG', 'TON', 'LBS', 'CBM', 'LTR', 'CTN', 'PLT', 'DRUM', 'BAG', '20DC', '40DC', '40HC', 'CDE', 'CDD', 'WINGBOX'
  unitName          String             // E.g., 'Kilograms', 'Metric Ton', 'Cubic Meter', 'Carton Box', 'Pallet', '20ft Dry Container', 'Colt Diesel Double'
  unitCategory      UnitCategory       @default(PACKAGE) // Enum: WEIGHT, VOLUME, PACKAGE, CONTAINER, TRUCK
  symbol            String?            // E.g., 'kg', 'ton', 'lbs', 'm³', 'L', 'ctn', 'plt'

  // Kapasitas muatan maksimal & detail fisik armada / kontainer (Kg & CBM)
  maxWeightKg       Decimal?           @db.Decimal(12, 3) // Kapasitas muatan maksimal (Kg)
  maxVolumeCbm      Decimal?           @db.Decimal(12, 3) // Kapasitas volume maksimal (CBM)
  tareWeightKg      Decimal?           @db.Decimal(12, 3) // Berat kosong kontainer / truk armada (Kg)
  lengthM           Decimal?           @db.Decimal(8, 3)  // Dimensi fisik: Panjang (meter)
  widthM            Decimal?           @db.Decimal(8, 3)  // Dimensi fisik: Lebar (meter)
  heightM           Decimal?           @db.Decimal(8, 3)  // Dimensi fisik: Tinggi (meter)

  isActive          Boolean            @default(true)
  description       String?

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  chargeCodes       MasterChargeCode[]
  packageJobFiles   JobFile[]          @relation("JobFilePackageUnit")
  containerJobFiles JobFile[]          @relation("JobFileContainerUnit")
  cargoDetails      JobCargoDetail[]
  invoiceItems      InvoiceItem[]

  @@index([unitCategory])
  @@index([unitCode])
  @@map("master_units")
}

// ==============================================================================
// 7b. MASTER ITEM TYPE ENTITY (Kategori & Klasifikasi Komoditas Barang)
// Global shared master data tanpa tenantId: General Cargo, Perishable, DG, dsb.
// ==============================================================================

model MasterItemType {
  id                String       @id @default(cuid())
  itemCode          String       @unique // E.g., 'GEN', 'PERISH', 'DG', 'ELEC', 'TEXTILE', 'AUTO', 'PHARMA'
  name              String       // E.g., 'General Cargo', 'Perishable Goods', 'Dangerous Goods (DG)', 'Consumer Electronics'
  isDangerousGoods  Boolean      @default(false)
  unNumber          String?      // Nomor UN jika Dangerous Goods (misal: 'UN 1993')
  classDg           String?      // Kelas IMO/IATA DG (misal: 'Class 3 Flammable Liquid')
  requiresColdChain Boolean      @default(false) // Flag pendingin / kontainer reefer
  minTemperature    Decimal?     @db.Decimal(5, 2) // Suhu minimum (°C)
  maxTemperature    Decimal?     @db.Decimal(5, 2) // Suhu maksimum (°C)
  description       String?
  isActive          Boolean      @default(true)

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  jobFiles          JobFile[]

  @@index([itemCode])
  @@index([isDangerousGoods])
  @@map("master_item_types")
}

// ==============================================================================
// 7c. MASTER COMMODITY ENTITY (Komoditas & HS Code Klasifikasi Pabean / Kepabeanan)
// Global shared master data tanpa tenantId: General Cargo, Electronics, Tobacco (HS: 24039990)
// ==============================================================================

model MasterCommodity {
  id           String           @id @default(cuid())
  name         String           // E.g., 'General Cargo', 'Electronics', 'Tobacco (HS: 24039990)'
  hsCode       String?          // E.g., '24039990' (Harmonized System Code)
  description  String?
  isActive     Boolean          @default(true)

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  cargoDetails JobCargoDetail[]

  @@index([name])
  @@index([hsCode])
  @@map("master_commodities")
}

// ==============================================================================
// 7d. MASTER INCOTERM ENTITY (Standard International Commercial Terms)
// Global shared master data tanpa tenantId: CIF, FOB, EXW, DDP, dll.
// ==============================================================================

model MasterIncoterm {
  id          String    @id @default(cuid())
  code        String    @unique // E.g., 'CIF', 'FOB', 'EXW', 'DDP', 'CFR'
  name        String    // E.g., 'Cost, Insurance and Freight', 'Free On Board', 'Ex Works'
  description String?
  isActive    Boolean   @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  jobFiles    JobFile[]

  @@index([code])
  @@map("master_incoterms")
}

// ==============================================================================
// 8. MASTER GEOGRAPHICAL DATA (Provinsi, Kota/Kabupaten, Kecamatan Indonesia)
// Kamus data referensi wilayah geografis nasional (Global shared master data)
// ==============================================================================

model MasterProvince {
  id        String       @id @default(cuid())
  code      String?      @unique // Kode Kemendagri / BPS (opsional, misal: '31' untuk DKI, '32' untuk Jabar)
  name      String       @unique // E.g., 'DKI Jakarta', 'Jawa Barat'
  isActive  Boolean      @default(true)

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  cities    MasterCity[]
  vendors   MasterVendor[]
  customers MasterCustomer[]

  @@index([name])
  @@map("master_provinces")
}

model MasterCity {
  id         String           @id @default(cuid())
  provinceId String
  province   MasterProvince   @relation(fields: [provinceId], references: [id], onDelete: Cascade)

  code       String?          @unique // Kode Kota/Kab (misal: '3172' untuk Jakut, '3273' untuk Kota Bandung)
  name       String           // E.g., 'Kota Bandung', 'Jakarta Utara', 'Kota Surabaya'
  type       String           @default("KOTA") // 'KOTA' atau 'KABUPATEN'
  isActive   Boolean          @default(true)

  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  districts  MasterDistrict[]
  vendors    MasterVendor[]
  customers  MasterCustomer[]

  @@unique([provinceId, name])
  @@index([provinceId])
  @@index([name])
  @@map("master_cities")
}

model MasterDistrict {
  id        String          @id @default(cuid())
  cityId    String
  city      MasterCity      @relation(fields: [cityId], references: [id], onDelete: Cascade)

  code      String?         @unique // Kode Kecamatan (misal: '3172010')
  name      String          // E.g., 'Sumur Bandung', 'Cicendo', 'Tanjung Priok', 'Kelapa Gading'
  isActive  Boolean         @default(true)

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  vendors   MasterVendor[]
  customers MasterCustomer[]

  @@unique([cityId, name])
  @@index([cityId])
  @@index([name])
  @@map("master_districts")
}

// ==============================================================================
// 9. MASTER VENDOR ENTITY (Sisi AP / Hutang Operasional)
// Categories: CARRIER_SEA, CARRIER_AIR, HAULAGE_TRUCK, CUSTOMS_BROKER, OTHERS
// ==============================================================================

model MasterVendor {
  id                String          @id @default(cuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  vendorCode        String          // E.g., 'VND-001'
  name              String          // E.g., 'Maersk Line Indonesia'
  category          VendorCategory  // CARRIER_SEA, CARRIER_AIR, HAULAGE_TRUCK, CUSTOMS_BROKER, OTHERS
  contactPerson     String?
  email             String?
  phone             String?
  address           String?
  
  // Hierarki Wilayah Geografis Indonesia
  provinceId        String?
  province          MasterProvince? @relation(fields: [provinceId], references: [id], onDelete: SetNull)
  cityId            String?
  cityRef           MasterCity?     @relation(fields: [cityId], references: [id], onDelete: SetNull)
  districtId        String?
  district          MasterDistrict? @relation(fields: [districtId], references: [id], onDelete: SetNull)

  city              String?         // Legacy / Display cache
  postalCode        String?
  country           String          @default("ID")
  taxId             String?         // NPWP Vendor
  creditLimit       Decimal         @default(0) @db.Decimal(15, 2) // Credit limit in base currency
  paymentTermDays   Int             @default(30) // TOP days
  bankName          String?
  bankAccountNumber String?
  bankAccountHolder String?
  iataPrefix        String?         // Kode prefix 3-digit IATA maskapai kargo udara (misal: '807' AirAsia, '126' Garuda Indonesia)
  isActive          Boolean         @default(true)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  jobFiles          JobFile[]

  @@unique([tenantId, vendorCode])
  @@index([tenantId])
  @@index([category])
  @@index([provinceId])
  @@index([cityId])
  @@index([districtId])
  @@map("master_vendors")
}

// ==============================================================================
// 10. MASTER CUSTOMER ENTITY (Sisi AR / Piutang Pelanggan Forwarder)
// Includes NPWP, Term of Payment (TOP / Jatuh Tempo), and Credit Limit
// ==============================================================================

model MasterCustomer {
  id              String          @id @default(cuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  customerCode    String          // E.g., 'CUST-001'
  name            String          // E.g., 'PT Sumber Makmur Ekspor'
  contactPerson   String?
  email           String?
  phone           String?
  address         String?

  // Hierarki Wilayah Geografis Indonesia
  provinceId      String?
  province        MasterProvince? @relation(fields: [provinceId], references: [id], onDelete: SetNull)
  cityId          String?
  cityRef         MasterCity?     @relation(fields: [cityId], references: [id], onDelete: SetNull)
  districtId      String?
  district        MasterDistrict? @relation(fields: [districtId], references: [id], onDelete: SetNull)

  city            String?         // Legacy / Display cache
  postalCode      String?
  country         String          @default("ID")
  taxId           String?         // NPWP Customer
  paymentTermDays Int             @default(30) // Term of Payment (TOP / Jatuh Tempo) in days
  creditLimit     Decimal         @default(0) @db.Decimal(15, 2) // Batas limit piutang
  isActive        Boolean         @default(true)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  jobFiles        JobFile[]
  invoices        Invoice[]

  @@unique([tenantId, customerCode])
  @@index([tenantId])
  @@index([provinceId])
  @@index([cityId])
  @@index([districtId])
  @@map("master_customers")
}

// ==============================================================================
// 10. MASTER PORT & ROUTE ENTITIES (Global Dictionary Pelabuhan & Rute Sedunia)
// Global master data (UN/LOCODE) shared across tenants without re-input
// ==============================================================================

model MasterPort {
  id                  String        @id @default(cuid())
  portCode            String        @unique // UN/LOCODE: E.g., 'IDJKT', 'SGSIN', 'IDCGK', 'IDSUB', 'NLRTM'
  portName            String        // E.g., 'Tanjung Priok', 'Port of Singapore', 'Soekarno-Hatta Int\'l Airport'
  portType            PortType      @default(SEA_PORT) // SEA_PORT, AIR_PORT, INLAND_TERMINAL
  city                String        // E.g., 'Jakarta', 'Singapore', 'Surabaya', 'Rotterdam'
  countryCode         String        // ISO2: 'ID', 'SG', 'NL', 'US', 'CN', 'JP'
  countryName         String        // 'Indonesia', 'Singapore', 'Netherlands'
  isMajor             Boolean       @default(true)
  isActive            Boolean       @default(true)
  latitude            Decimal?      @db.Decimal(10, 6)
  longitude           Decimal?      @db.Decimal(10, 6)

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  originJobFiles      JobFile[]     @relation("JobFileOriginPort")
  destinationJobFiles JobFile[]     @relation("JobFileDestinationPort")
  transitJobFiles     JobFile[]     @relation("JobFileTransitPort")
  originRoutes        MasterRoute[] @relation("RouteOriginPort")
  destinationRoutes   MasterRoute[] @relation("RouteDestinationPort")

  @@index([portType])
  @@index([countryCode])
  @@map("master_ports")
}

model MasterRoute {
  id                String        @id @default(cuid())
  routeCode         String        @unique // E.g., 'IDJKT-SGSIN', 'IDJKT-NLRTM', 'IDCGK-SIN'
  routeName         String        // E.g., 'Jakarta to Singapore Maritime Lane'
  originPortId      String
  originPort        MasterPort    @relation("RouteOriginPort", fields: [originPortId], references: [id], onDelete: Cascade)
  destinationPortId String
  destinationPort   MasterPort    @relation("RouteDestinationPort", fields: [destinationPortId], references: [id], onDelete: Cascade)
  transportMode     TransportMode @default(SEA)
  estTransitDays    Int           @default(3) // Estimated standard transit days
  isActive          Boolean       @default(true)

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([originPortId])
  @@index([destinationPortId])
  @@map("master_routes")
}

// ==============================================================================
// 11. MASTER CHARGE CODE ENTITY (Komponen Biaya Pengiriman)
// Identifies freight, trucking, THC, document fees, currency link, and PPN taxable status
// ==============================================================================

model MasterChargeCode {
  id            String          @id @default(cuid())
  tenantId      String?         // null = global system default, non-null = tenant specific customization
  tenant        Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  chargeCode    String          // E.g., 'OFRT', 'AFRT', 'THC', 'DOC_FEE', 'CUST_EXP', 'TRK_INLAND'
  chargeName    String          // E.g., 'Ocean Freight', 'Air Freight', 'Terminal Handling Charge (THC)', 'Document / BL Fee'
  category      ChargeCategory  @default(FREIGHT)
  transportMode TransportMode?  // SEA, AIR, INLAND, MULTIMODAL, or null for all

  // Relasi MasterCurrency
  currencyId    String?
  currencyRef   MasterCurrency? @relation(fields: [currencyId], references: [id], onDelete: SetNull)
  currency      String          @default("IDR")

  // Relasi MasterUnit (Satuan Item / UoM)
  unitId        String?
  unitRef       MasterUnit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  unit          String?         @default("TRIP")

  defaultPrice  Decimal         @default(0) @db.Decimal(15, 2)
  isTaxable     Boolean         @default(true) // Status pengenaan pajak (Taxable)
  taxId         String?
  tax           MasterTax?      @relation(fields: [taxId], references: [id], onDelete: SetNull)
  isActive      Boolean         @default(true)
  description   String?

  invoiceItems  InvoiceItem[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([tenantId, chargeCode])
  @@index([tenantId])
  @@index([category])
  @@map("master_charge_codes")
}

// ==============================================================================
// 12. JOB FILE ENTITY (Core Operational Shipment File / Muatan Kargo)
// Strict relational links to MasterCustomer, MasterVendor, MasterPort, MasterCurrency, MasterUnit
// ==============================================================================

model JobFile {
  id                   String          @id @default(cuid())
  tenantId             String
  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Auto-numbered identifier generated via MasterPrefix (type: JOB_FILE)
  jobFileNumber        String          // E.g., 'JF/2026/10/00001'

  // Relational Stakeholders
  customerId           String
  customer             MasterCustomer  @relation(fields: [customerId], references: [id], onDelete: Restrict)

  vendorId             String?
  vendor               MasterVendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  // Operational Metadata
  status               JobFileStatus   @default(DRAFT)
  transportMode        TransportMode   @default(SEA)
  bizMode              BizMode?        @default(SEA)
  bound                Bound?          @default(EXPORT)
  shipmentType         ShipmentType    @default(EXPORT)
  incoterm             String          @default("FOB") // Ref to SystemDictionary / text label
  incotermId           String?
  incotermRef          MasterIncoterm? @relation(fields: [incotermId], references: [id], onDelete: SetNull)
  exchangeRate         Decimal?        @db.Decimal(15, 4) // Kunci kurs valuta asing (USD/IDR, dll)

  // Ports: Linked relationally to MasterPort + text display cache
  originPortId         String?
  originPortRef        MasterPort?     @relation("JobFileOriginPort", fields: [originPortId], references: [id], onDelete: SetNull)
  originPort           String          // Display label cache: E.g., 'IDJKT (Tanjung Priok, Jakarta)'

  destinationPortId    String?
  destinationPortRef   MasterPort?     @relation("JobFileDestinationPort", fields: [destinationPortId], references: [id], onDelete: SetNull)
  destinationPort      String          // Display label cache: E.g., 'SGSIN (Port of Singapore)'

  // Multi-Leg & Transit Routing (Air Freight / Hub Transit)
  transitPortId        String?
  transitPortRef       MasterPort?     @relation("JobFileTransitPort", fields: [transitPortId], references: [id], onDelete: SetNull)
  transitPort          String?         // E.g., 'KUL (Kuala Lumpur International Airport)'
  secondCarrier        String?         // E.g., 'AK' or 'AirAsia Berhad'
  connectingFlightNo   String?         // E.g., 'AK552/14'

  // Stakeholder Tambahan (Consignee Luar Negeri & Notify Party)
  consigneeName        String?         // E.g., 'DO THI THAO' or 'Shengda International Co.'
  consigneeAddress     String?         // E.g., 'Shengda International Hotel, Sikhottabong'
  consigneeCity        String?         // E.g., 'Vientiane'
  consigneeCountry     String?         @default("LA")
  consigneePostalCode  String?         // E.g., '12000'
  consigneePhone       String?         // E.g., '020-58885793'
  consigneeAccountNo   String?         // E.g., 'CUST-003'
  consigneeTaxId       String?         // Tax ID / VAT No
  notifyParty          String?         // E.g., 'SAME AS CONSIGNEE' or Agent Name & Contact

  vesselOrFlight       String?         // E.g., 'MAERSK JAKARTA' or 'AIR ASIA (AK354 / AK552)'
  voyageOrFlightNo     String?         // E.g., 'V.2610N' or 'AK354'
  masterBillOfLading   String?         // Master B/L (Sea) or Master AWB (Air)
  houseBillOfLading    String?         // House B/L (Sea) or House AWB (Air)

  // IATA Valuation & Payment Terms
  paymentTermMode      String?         @default("PP") // 'PP' (Prepaid) or 'CC' (Collect)
  declaredValueCarriage String?        @default("NVD") // 'NVD' (No Value Declared) or amount
  declaredValueCustoms String?         @default("NCV") // 'NCV' (No Customs Value) or amount
  insuranceAmount      String?         @default("NIL") // 'NIL' or amount
  handlingInformation  String?         // E.g., 'PLEASE CONTACT TO OUR CONSIGNEE UPON CARGO ARRIVAL. THANKS'

  // Schedule Dates
  bookingDate          DateTime        @default(now())
  etd                  DateTime?       // Estimated Time of Departure
  atd                  DateTime?       // Actual Time of Departure
  eta                  DateTime?       // Estimated Time of Arrival
  ata                  DateTime?       // Actual Time of Arrival

  // Cargo Specifications & Satuan (MasterUnit: PACKAGE / WEIGHT / VOLUME)
  grossWeightKg        Decimal?        @db.Decimal(12, 3)
  volumeWeightCbm      Decimal?        @db.Decimal(12, 3)
  packageCount         Int?
  packageType          String?         // Dynamically populated from MasterUnit / SystemDictionary
  packageUnitId        String?
  packageUnitRef       MasterUnit?     @relation("JobFilePackageUnit", fields: [packageUnitId], references: [id], onDelete: SetNull)

  // Dimensi & Tipe Kontainer / Truk Armada (MasterUnit: CONTAINER / TRUCK)
  containerUnitId      String?
  containerUnitRef     MasterUnit?     @relation("JobFileContainerUnit", fields: [containerUnitId], references: [id], onDelete: SetNull)
  containerCount       Int?            @default(1)
  containerSummary     String?         // E.g., '1x20\'DC (MRKU9876543)' or '1x Wingbox'

  // Klasifikasi Komoditas (MasterItemType)
  itemTypeId           String?
  itemTypeRef          MasterItemType? @relation(fields: [itemTypeId], references: [id], onDelete: SetNull)
  commodityDescription String?

  // Financial Ledger Overview (Buying vs. Selling)
  sellingAmount        Decimal         @default(0) @db.Decimal(15, 2) // Total Receivable (Piutang)
  buyingAmount         Decimal         @default(0) @db.Decimal(15, 2) // Total Payable (Hutang)
  currencyId           String?
  currencyRef          MasterCurrency? @relation(fields: [currencyId], references: [id], onDelete: SetNull)
  currency             String          @default("IDR")
  billingStatus        BillingStatus   @default(UNBILLED)

  remarks              String?
  createdById          String?

  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  invoices             Invoice[]
  cargoDetails         JobCargoDetail[]

  @@unique([tenantId, jobFileNumber])
  @@index([tenantId])
  @@index([customerId])
  @@index([vendorId])
  @@index([status])
  @@index([bizMode])
  @@index([bound])
  @@index([incotermId])
  @@map("job_files")
}

// ==============================================================================
// 12b. JOB CARGO DETAIL ENTITY (Rincian Muatan, Dimensi Kardus/Koli & Komoditas)
// Relasi One-to-Many ke JobFile: P x L x T, Gross Weight, Chargeable Weight, UoM, Komoditas
// Sesuai fakta operasional AWB Air Asia (60 Cartons, 40x26x35cm, GWT/CWT 598 Kg, 2.184 CBM)
// ==============================================================================

model JobCargoDetail {
  id               String           @id @default(cuid())
  jobFileId        String
  jobFile          JobFile          @relation(fields: [jobFileId], references: [id], onDelete: Cascade)

  // Field muatan standar
  pieces           Int              @default(1) // Koli / Qty kardus (misal: 60)
  grossWeight      Decimal          @db.Decimal(12, 3) // Berat kotor dalam Kg (misal: 598.000)
  chargeableWeight Decimal          @db.Decimal(12, 3) // Chargeable weight dalam Kg (misal: 598.000)
  volumeCbm        Decimal          @db.Decimal(12, 3) // Volume dalam CBM (misal: 2.184)

  // Field dimensi fisik (opsional, P x L x T dalam cm)
  length           Decimal?         @db.Decimal(10, 2) // Panjang (cm)
  width            Decimal?         @db.Decimal(10, 2) // Lebar (cm)
  height           Decimal?         @db.Decimal(10, 2) // Tinggi (cm)

  // Field relasi master data
  unitId           String?
  unitRef          MasterUnit?      @relation(fields: [unitId], references: [id], onDelete: SetNull)

  commodityId      String?
  commodityRef     MasterCommodity? @relation(fields: [commodityId], references: [id], onDelete: SetNull)

  description      String?          // E.g., '40 x 26 x 35CM / 60CTNS'

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([jobFileId])
  @@index([unitId])
  @@index([commodityId])
  @@map("job_cargo_details")
}

// ==============================================================================
// 13. INVOICE ENTITY (Commercial Invoice & AR Billing)
// Relational billing record tied to JobFile, MasterCustomer, MasterTax, MasterCurrency
// ==============================================================================

model Invoice {
  id              String          @id @default(cuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Auto-numbered identifier generated via MasterPrefix (type: INVOICE)
  invoiceNumber   String          // E.g., 'INV/2026/00001'

  jobFileId       String
  jobFile         JobFile         @relation(fields: [jobFileId], references: [id], onDelete: Restrict)

  customerId      String
  customer        MasterCustomer  @relation(fields: [customerId], references: [id], onDelete: Restrict)

  invoiceDate     DateTime        @default(now())
  dueDate         DateTime

  currencyId      String?
  currencyRef     MasterCurrency? @relation(fields: [currencyId], references: [id], onDelete: SetNull)
  currency        String          @default("IDR")
  subtotal        Decimal         @db.Decimal(15, 2)
  
  // Tax Relation to MasterTax
  taxId           String?
  tax             MasterTax?      @relation(fields: [taxId], references: [id], onDelete: SetNull)
  taxRatePercent  Decimal         @default(1.1) @db.Decimal(6, 3) // PPN Jasa Pengurusan Transportasi (1.1%)
  taxAmount       Decimal         @default(0) @db.Decimal(15, 2)
  totalAmount     Decimal         @db.Decimal(15, 2)

  status          InvoiceStatus   @default(UNPAID)
  paidAt          DateTime?
  paymentMethod   String?         // E.g., 'Bank Transfer BCA', 'Wire Transfer'

  cargoSummary    String?         // Snapshot: E.g., '2x40HQ | 22,500 Kg | 68.2 CBM'
  notes           String?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  items           InvoiceItem[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([jobFileId])
  @@index([customerId])
  @@index([status])
  @@map("invoices")
}

// ==============================================================================
// 13b. INVOICE ITEM ENTITY (Rincian Komponen Biaya / Itemized Freight Charges)
// Sesuai standar faktur LX Pantos: Freight, FSC, THC, AWB Fee, Trucking, Clearance
// ==============================================================================

model InvoiceItem {
  id              String             @id @default(cuid())
  invoiceId       String
  invoice         Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  chargeCodeId    String?
  chargeCodeRef   MasterChargeCode?  @relation(fields: [chargeCodeId], references: [id], onDelete: SetNull)
  chargeCode      String?            // E.g., 'AFRT', 'OFRT', 'FSC', 'THC', 'DOC_FEE'
  description     String             // E.g., 'AIR FREIGHT CHARGES', 'FUEL SURCHARGE (FSC)'

  unitId          String?
  unitRef         MasterUnit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  unit            String?            // E.g., 'CWT', 'CBM', 'SHPT', '20DC', 'CONT'

  quantity        Decimal            @default(1) @db.Decimal(12, 3)
  rate            Decimal            @db.Decimal(15, 2)
  amount          Decimal            @db.Decimal(15, 2) // DPP = quantity * rate
  currency        String             @default("IDR")

  taxRatePercent  Decimal            @default(1.1) @db.Decimal(6, 3) // 0%, 1.1%, 11%, 12%
  taxAmount       Decimal            @default(0) @db.Decimal(15, 2)
  totalAmount     Decimal            @db.Decimal(15, 2) // amount + taxAmount

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([invoiceId])
  @@index([chargeCodeId])
  @@index([unitId])
  @@map("invoice_items")
}

// ==============================================================================
// 14. SYSTEM DICTIONARY ENTITY (No-Hardcode Dynamic Options & Reference Data)
// Satisfies Golden Rule: All labels, options, and reference data are DB-driven.
// ==============================================================================

model SystemDictionary {
  id          String   @id @default(cuid())
  tenantId    String?  // null for system-wide defaults, non-null for tenant-specific overrides
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  category    String   // E.g., 'INCOTERM', 'PACKAGE_TYPE', 'CURRENCY', 'SUBSCRIPTION_PLAN'
  code        String   // E.g., 'FOB', 'CIF', '20GP', '40HQ', 'PALLET', 'BOX'
  label       String   // E.g., 'Free On Board', 'Cost Insurance and Freight'
  sortOrder   Int      @default(0)
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  metadata    Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, category, code])
  @@index([category])
  @@map("system_dictionaries")
}

// ==============================================================================
// 15. ARTICLE ENTITY (SEO, Educational Hub & Automated Content Publishing)
// ==============================================================================

model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  category    String
  summary     String   @db.Text
  coverImage  String?  // URL to realistic editorial photo
  author      String
  authorRole  String
  readTime    String   @default("5 menit baca")
  content     Json     // Structured sections, callout, and takeaways
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([category])
  @@index([isPublished])
  @@map("articles")
}
